// unit_regex.sz — tests for the Regex namespace (dependency-free engine).
// Patterns use raw strings r"..." so backslashes reach the engine verbatim.

// ── test / anchors ────────────────────────────────────────────────────────────
test("test matches anywhere", () => {
    assert(Regex.test(r"\d+", "abc123") == true, "digits present");
    assert(Regex.test(r"\d+", "abcdef") == false, "no digits");
});

test("anchors ^ and $", () => {
    assert(Regex.test(r"^\d+$", "12345") == true, "fully numeric");
    assert(Regex.test(r"^\d+$", "12a45") == false, "not fully numeric");
    assert(Regex.test(r"^abc", "abcdef") == true, "starts with abc");
    assert(Regex.test(r"def$", "abcdef") == true, "ends with def");
});

// ── character classes ─────────────────────────────────────────────────────────
test("character classes and ranges", () => {
    assert(Regex.test(r"[a-c]+", "cab") == true, "range a-c");
    assert(Regex.test(r"[^0-9]", "123") == false, "negated class no letters");
    assert(Regex.test(r"[0-9]", "a1") == true, "class finds a digit");
});

test("shorthand classes \\d \\w \\s", () => {
    assert(Regex.test(r"\w+", "hello_1") == true, "word chars");
    assert(Regex.test(r"\s", "a b") == true, "has whitespace");
    assert(Regex.test(r"\s", "ab") == false, "no whitespace");
});

// ── quantifiers ───────────────────────────────────────────────────────────────
test("quantifiers and bounded repetition", () => {
    let m = Regex.match(r"a{2,3}", "aaaa");
    assert(m[0] == "aaa", "bounded greedy takes 3");
    let m2 = Regex.match(r"a{2}", "aaaa");
    assert(m2[0] == "aa", "exact count");
    assert(Regex.test(r"ab?c", "ac") == true, "optional b");
    assert(Regex.test(r"ab?c", "abc") == true, "present b");
});

test("greedy vs lazy", () => {
    let g = Regex.match(r"a.*b", "axbxb");
    assert(g[0] == "axbxb", "greedy to last b");
    let l = Regex.match(r"a.*?b", "axbxb");
    assert(l[0] == "axb", "lazy to first b");
});

// ── groups + alternation ──────────────────────────────────────────────────────
test("capturing groups", () => {
    let m = Regex.match(r"(\w+)@(\w+)\.(\w+)", "joe@example.com");
    assert(m[0] == "joe@example.com", "whole match");
    assert(m[1] == "joe", "group 1");
    assert(m[2] == "example", "group 2");
    assert(m[3] == "com", "group 3");
});

test("non-capturing group and alternation", () => {
    let m = Regex.match(r"(?:ab)+(c)", "ababc");
    assert(m[0] == "ababc", "repeated non-capturing group");
    assert(m[1] == "c", "only real group captured");
    assert(Regex.test(r"cat|dog|bird", "I like dogs") == true, "alternation");
});

test("match returns null when no match", () => {
    assert(Regex.match(r"xyz", "abc") == null, "no match is null");
});

// ── findAll / split / replace ──────────────────────────────────────────────────
test("findAll returns all matches", () => {
    let all = Regex.findAll(r"\d+", "a1b22c333");
    assert(all.length() == 3, "three number runs");
    assert(all[0] == "1", "first");
    assert(all[1] == "22", "second");
    assert(all[2] == "333", "third");
});

test("split on a pattern", () => {
    let parts = Regex.split(r",\s*", "a, b,c ,  d");
    assert(parts.length() == 4, "four parts");
    assert(parts[0] == "a", "part 0");
    assert(parts[3] == "d", "part 3");
});

test("replace all with literal", () => {
    assert(Regex.replace(r"\d+", "a1b22c333", "#") == "a#b#c#", "replace runs with #");
    assert(Regex.replace(r"[^0-9]", "a1b2c3", "") == "123", "strip non-digits");
});

test("replace with group backreferences", () => {
    assert(Regex.replace(r"(\w+)@(\w+)", "joe@corp", "$2.$1") == "corp.joe", "swap groups");
    assert(Regex.replace(r"\d", "x1y", "[$&]") == "x[1]y", "$& is whole match");
    assert(Regex.replace(r"a", "a", "$$") == "$", "$$ is literal dollar");
});

// ── invalid pattern is a catchable programming error ────────────────────────────
test("invalid pattern is catchable", () => {
    let caught = false;
    try {
        let x = Regex.test(r"(unbalanced", "abc");
    } catch (e) {
        caught = true;
    }
    assert(caught, "unbalanced group throws a catchable error");
});

// ── the error contract: arity matches every other namespace ─────────────────────
test("wrong arity is TypeError / SZ4002, like every other namespace", () => {
    // Regex used to answer a wrong argument count with the generic
    // RuntimeError / SZ4000, so a caller matching on kind could not tell
    // "called wrongly" from any other runtime failure. Six spec documents state
    // the TypeError rule normatively; Regex was the only holdout. Same shape as
    // Set's unknown member, recorded in errors.md, fixed the same way.
    let code = "";
    let kind = "";
    try {
        let x = Regex.match("a");
    } catch (e) {
        code = e.code;
        kind = e.kind;
    }
    assert(code == "SZ4002", "code was " + code);
    assert(kind == "TypeError", "kind was " + kind);
});

test("an unknown member stays ReferenceError / SZ4001", () => {
    let code = "";
    try { let x = Regex.nope("a", "b"); } catch (e) { code = e.code; }
    assert(code == "SZ4001", "code was " + code);
});

test("a malformed pattern stays the generic RuntimeError", () => {
    // Deliberate, not an oversight: there is no SyntaxError kind to move it to,
    // and inventing one would be a new code. Recorded in errors.md.
    let kind = "";
    try { let x = Regex.match("(", "a"); } catch (e) { kind = e.kind; }
    assert(kind == "RuntimeError", "kind was " + kind);
});

// -- the constructs that are silently something else ---------------------------
// None of these is rejected. Each parses as ordinary characters and matches the
// wrong thing, which is why spec/regex.md gives them a table of their own. They
// are pinned so a change to the pattern parser cannot alter them in either
// direction without a test saying so.
test("a lookahead is a group of literal characters", () => {
    assert(Regex.test(r"a(?=b)", "ab") == false, "does not act as a lookahead");
    assert(Regex.test(r"a(?=b)", "a?=b"), "matches the literal characters instead");
});

test("a negative lookahead is a group of literal characters", () => {
    assert(Regex.test(r"a(?!b)", "ac") == false, "does not act as a lookahead");
    assert(Regex.test(r"a(?!b)", "a?!b"), "matches the literal characters instead");
});

test("a named group is a group of literal characters", () => {
    assert(Regex.test(r"(?<n>a)", "?<n>a"), "matches the literal characters");
});

test("a backreference is the literal digit", () => {
    assert(Regex.test(r"(a)\1", "aa") == false, "does not back-reference");
    assert(Regex.test(r"(a)\1", "a1"), "matches a literal 1 instead");
});

test("word boundary is the literal letter b", () => {
    assert(Regex.test(r"a\bc", "abc"), "matches a literal b instead");
    assert(Regex.test(r"\bcat\b", "a cat here") == false, "is not a boundary");
});

// -- shapes the document states ------------------------------------------------
test("match returns null when nothing matches, not an empty array", () => {
    assert(Regex.match(r"z", "abc") == null, "null, not an empty array");
});

test("replace takes the replacement last and replaces every occurrence", () => {
    assert(Regex.replace(r"a", "banana", "X") == "bXnXnX", "every occurrence");
});

test("the replacement group form reads exactly one digit", () => {
    // $10 is group 1 then a literal 0, not group 10; and a $n naming a group
    // the pattern does not have stays literal.
    assert(Regex.replace(r"(a)", "a", "$10") == "a0", "one digit only");
    assert(Regex.replace(r"(a)(b)", "ab", "$5") == "$5", "absent group stays literal");
    assert(Regex.replace(r"a", "a", "x$") == "x$", "a trailing dollar is literal");
    assert(Regex.replace(r"a", "a", "$z") == "$z", "a dollar before anything else is literal");
});

test("an empty pattern does not split per character", () => {
    let parts = Regex.split(r"", "abc");
    assert(parts.length() == 1, "one element, got " + parts.length());
    assert(parts[0] == "abc", "the whole text");
});

test("matching is case-sensitive and there are no flags", () => {
    assert(Regex.test(r"A", "a") == false, "no case-insensitive mode");
});

test("dot does not match a newline", () => {
    assert(Regex.test(r"a.b", "a\nb") == false, "dot excludes newline");
});

summary();
