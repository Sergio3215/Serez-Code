// const keyword: immutability rules, all types, scope, array contents
// The test framework catches throws, so const reassignment tests
// are in sec_const_*.sz (error tests). Here we test valid const usage.

const MAX_SIZE = 100;
const PI = 3.14159;
const APP_NAME = "Serez";
const DEBUG = false;
const EMPTY_BASE = 0;

test("const int is readable at global scope", () => {
    assert(MAX_SIZE == 100,    "MAX_SIZE = 100");
    assert(EMPTY_BASE == 0,    "EMPTY_BASE = 0");
});

test("const decimal is readable at global scope", () => {
    assert(PI > 3.14,          "PI > 3.14");
    assert(PI < 3.15,          "PI < 3.15");
});

test("const string is readable at global scope", () => {
    assert(APP_NAME == "Serez",    "APP_NAME = 'Serez'");
    assert(APP_NAME.length() == 5, "APP_NAME has 5 chars");
});

test("const bool is readable at global scope", () => {
    assert(DEBUG == false, "DEBUG = false");
    assert(!DEBUG,         "!DEBUG is true");
});

test("const used in expression", () => {
    let radius = 5.0;
    let area = PI * radius * radius;
    assert(area > 78.5 && area < 78.6, "area = PI * 5^2 ≈ 78.54");
});

test("const used as loop bound", () => {
    let sum = 0;
    const LIMIT = 10;
    for (let i = 1; i <= LIMIT; i++) {
        sum = sum + i;
    }
    assert(sum == 55, "sum 1..10 = 55 using const LIMIT");
});

test("const in function scope is locally scoped", () => {
    fn int computeMax() {
        const LOCAL_MAX = 42;
        return LOCAL_MAX;
    }
    assert(computeMax() == 42, "const in function returns 42");
    assert(computeMax() == 42, "second call also returns 42");
});

test("multiple calls to function with const don't interfere", () => {
    fn decimal circleArea(decimal r) {
        const LOCAL_PI = 3.14159;
        return LOCAL_PI * r * r;
    }
    let a1 = circleArea(1.0);
    let a2 = circleArea(2.0);
    assert(a2 > a1 * 3.9 && a2 < a1 * 4.1, "area(2r) ≈ 4 * area(r)");
});

test("const array is readable (elements accessible)", () => {
    const PRIMES = [2, 3, 5, 7, 11, 13];
    assert(PRIMES[0] == 2,  "PRIMES[0] = 2");
    assert(PRIMES[4] == 11, "PRIMES[4] = 11");
    assert(PRIMES.length() == 6, "6 primes");
});

test("const array can be iterated with for-in", () => {
    const VOWELS = ["a", "e", "i", "o", "u"];
    let count = 0;
    for (let v in VOWELS) {
        count = count + 1;
    }
    assert(count == 5, "iterated all 5 vowels");
});

test("const used in switch case", () => {
    const CODE_OK    = 200;
    const CODE_ERROR = 500;
    fn string httpStatus(int code) {
        switch (code) {
            case 200: { return "ok"; }
            case 500: { return "error"; }
            default:  { return "other"; }
        }
    }
    assert(httpStatus(CODE_OK)    == "ok",    "200 -> ok");
    assert(httpStatus(CODE_ERROR) == "error", "500 -> error");
});

test("const string used in concatenation", () => {
    const PREFIX = "Hello, ";
    let greeting = PREFIX + "world!";
    assert(greeting == "Hello, world!", "const prefix concatenated");
});

test("const bool used in logical expression", () => {
    const IS_PROD = true;
    const ENABLE_LOGS = false;
    let shouldLog = !IS_PROD || ENABLE_LOGS;
    assert(shouldLog == false, "not prod and logs disabled = false");
});

// ── DEC-M12-003: `const` freezes the binding, not the value ──────────────────
//
// Decided 2026-09-05, and closed with no runtime change: this is what the
// runtime already did. What was missing is exactly what these cases add. The
// suite above covered reads, scoping and rebinding rejection, so the *value*
// half of the rule was true by accident rather than by test — nothing would
// have failed if a later change had started freezing values, or had stopped
// refusing a rebind.
//
// So the rule is walked across every container and every operation it applies
// to. What `const` refuses is one thing: making the name refer to something
// else. Everything a `let` binding permits on the value, a `const` binding
// permits too.

test("DEC-M12-003: const refuses to rebind the name", () => {
    const total = 1;
    let caught = false;
    try {
        total = 2;
    } catch (e) {
        caught = true;
    }
    assert(caught, "reassigning the name is refused");
    assert(total == 1, "and the binding is unchanged");
});

test("DEC-M12-003: a const array is writable through an index", () => {
    const scores = [10, 20];
    scores[0] = 99;
    assert(scores[0] == 99, "the element was written");
    assert(scores[1] == 20, "and its neighbour was not");
});

test("DEC-M12-003: a const array is writable through its methods", () => {
    const scores = [10, 20];
    scores.push(30);
    assert(scores.length() == 3, "push works");
    assert(scores[2] == 30, "and appended the value");
    let last = scores.pop();
    assert(last == 30, "pop works");
    assert(scores.length() == 2, "and shortened it");
});

test("DEC-M12-003: a const array still refuses to be rebound", () => {
    const scores = [10, 20];
    let caught = false;
    try {
        scores = [1];
    } catch (e) {
        caught = true;
    }
    assert(caught, "rebinding the name is refused");
    assert(scores.length() == 2, "and the array is untouched");
    assert(scores[0] == 10, "with its original contents");
});

test("DEC-M12-003: a const dict is writable through both spellings", () => {
    // The two forms are one write (DEC-M12-002), so they cannot differ here
    // either: whatever const permits, it permits for both.
    const config <string, any> = ({"debug", false});
    config["debug"] = true;
    assert(config.debug == true, "the bracket write took");
    config.debug = false;
    assert(config["debug"] == false, "and so did the dot write");
    config.added = 1;
    assert(config["added"] == 1, "a new key is created, as under let");
});

test("DEC-M12-003: a const dict is writable through its methods, and not rebindable", () => {
    const config <string, any> = ({"debug", false});
    config.Add({"level", 3});
    assert(config.length() == 2, "Add works");
    config.Remove("level");
    assert(config.length() == 1, "Remove works");

    // A dict literal is not an expression (see dicts.md), so the rebind is
    // attempted with another annotated binding rather than a literal.
    let other <string, any> = ({"x", 1});
    let caught = false;
    try {
        config = other;
    } catch (e) {
        caught = true;
    }
    assert(caught, "rebinding the name is refused");
    assert(config.length() == 1, "and the dict is untouched");
});

summary();
