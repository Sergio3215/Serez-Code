// unit_dict_dot_access.sz
// ─────────────────────────────────────────────────────────────────────────────
// `dic.name` is a second way to write `dic["name"]` — a second *form*, not a
// second *semantics*. Every case below asserts the two forms against each
// other rather than against a hard-coded expectation, so they cannot drift
// apart later: if the bracket policy ever changes, these fail together instead
// of silently describing two different languages.
//
// The syntax was already there. The parser produces a DotCall with
// `has_parens: false` for `dic.name`, and the semantic phase and the type
// checker already accepted it — only the runtime refused it, with
// "Unknown dict method 'name'". So what is pinned here is the runtime
// behaviour of an existing syntax, not a new one.
//
// Under DEC-M12-001 the receiver decides: because the receiver is a dict,
// `d.k` is the key "k" and the method table is never consulted for it. `d.k()`
// is the call form and still runs the method. Writes follow DEC-M12-002 and
// live in `unit_dict_dot_assign.sz`.

class DotAccessProbe {
    public DotAccessProbe(string n) { this.name = n; }
    public string greet() { return "hi " + this.name; }
}

// ── The two forms agree ──────────────────────────────────────────────────────

test("dot access reads the key that brackets read", () => {
    let dic <string, any> = ({"name", "Sergio"});
    assert(dic["name"] == "Sergio", "brackets still read the key");
    assert(dic.name == "Sergio", "dot reads the same key");
    assert(dic.name == dic["name"], "the two forms are the same value");
});

test("the key is the identifier exactly as written", () => {
    // No case folding, no camelCase-to-snake_case translation: `firstName`
    // means the key "firstName" and nothing else.
    let dic <string, any> = ({"firstName", "Sergio"});
    assert(dic.firstName == "Sergio", "the identifier is the key verbatim");
    assert(dic.firstname == null, "a differently-cased key is a different key");
    assert(dic.first_name == null, "no separator translation happens");
});

test("several keys, each reachable both ways", () => {
    let dic <string, any> = ({"name", "Sergio"}, {"city", "Rosario"}, {"role", "owner"});
    assert(dic.name == dic["name"], "first key agrees");
    assert(dic.city == dic["city"], "second key agrees");
    assert(dic.role == dic["role"], "third key agrees");
    assert(dic.city == "Rosario", "and reads the right value");
});

// ── Every value type a <string, any> dict can hold ────────────────────────────

test("string values", () => {
    let dic <string, any> = ({"v", "text"});
    assert(dic.v == "text", "dot reads a string");
    assert(dic.v == dic["v"], "agrees with brackets");
});

test("numeric values, integer and float", () => {
    let dic <string, any> = ({"i", 42}, {"f", 3.5});
    assert(dic.i == 42, "dot reads an int");
    assert(dic.f == 3.5, "dot reads a float");
    assert(dic.i == dic["i"], "int agrees with brackets");
    assert(dic.f == dic["f"], "float agrees with brackets");
});

test("boolean values", () => {
    let dic <string, any> = ({"yes", true}, {"no", false});
    assert(dic.yes == true, "dot reads true");
    assert(dic.no == false, "dot reads false");
    assert(dic.yes == dic["yes"], "true agrees with brackets");
    assert(dic.no == dic["no"], "false agrees with brackets");
});

test("a null value is a present key, not a missing one", () => {
    let dic <string, any> = ({"v", null});
    assert(dic.v == null, "dot reads the stored null");
    assert(dic.v == dic["v"], "agrees with brackets");
    assert(dic.length() == 1, "the key is really there");
});

test("an array value", () => {
    let dic <string, any> = ({"xs", [1, 2, 3]});
    assert(dic.xs[1] == 2, "dot access then index");
    assert(dic.xs[1] == dic["xs"][1], "agrees with brackets");
});

// ── Nesting, and the two forms mixed in one expression ───────────────────────

test("nested dicts, all four ways of writing the same read", () => {
    let inner <string, any> = ({"name", "Inner"});
    let dic <string, any> = ({"user", inner});
    assert(dic["user"]["name"] == "Inner", "brackets, brackets");
    assert(dic.user.name == "Inner", "dot, dot");
    assert(dic["user"].name == "Inner", "brackets, dot");
    assert(dic.user["name"] == "Inner", "dot, brackets");
});

test("three levels deep", () => {
    let leaf <string, any> = ({"v", "deep"});
    let mid <string, any> = ({"leaf", leaf});
    let top <string, any> = ({"mid", mid});
    assert(top.mid.leaf.v == "deep", "a chain of dots");
    assert(top.mid.leaf.v == top["mid"]["leaf"]["v"], "agrees with brackets");
});

// ── Missing keys reuse the existing policy ───────────────────────────────────

test("a missing key answers what a missing key already answered", () => {
    let dic <string, any> = ({"name", "Sergio"});
    assert(dic["missing"] == null, "the bracket policy, measured");
    assert(dic.missing == null, "dot follows it rather than inventing one");
    assert(dic.missing == dic["missing"], "the two forms agree when absent");
});

test("a missing key on an empty dict", () => {
    let dic <string, any> = ();
    assert(dic.anything == null, "no key, no error");
    assert(dic.anything == dic["anything"], "still agrees with brackets");
});

// ── Reading does not change the dict ──────────────────────────────────────────

test("repeated dot access returns the same value every time", () => {
    let dic <string, any> = ({"n", 1});
    assert(dic.n == 1, "first read");
    assert(dic.n == 1, "second read");
    assert(dic.n == 1, "third read");
});

test("reading a key — present or missing — does not mutate the dict", () => {
    let dic <string, any> = ({"name", "Sergio"});
    assert(dic.length() == 1, "one key to start");
    let seen = dic.name;
    let absent1 = dic.missing;
    let absent2 = dic.missing;
    assert(seen == "Sergio", "the read produced the value");
    assert(absent1 == null, "and the missing reads produced null");
    assert(absent2 == null, "twice");
    assert(dic.length() == 1, "reading a missing key did not insert it");
    assert(dic["name"] == "Sergio", "the present key is untouched");
    assert(dic.missing == null, "the missing key is still missing");
});

// ── Optional chaining reaches the same arm ───────────────────────────────────

test("optional chaining reads a key", () => {
    let inner <string, any> = ({"name", "Inner"});
    let dic <string, any> = ({"user", inner});
    assert(dic?.name == null, "no such key, and no error");
    assert(dic?.user?.name == "Inner", "a chain of optional dots");
    assert(dic?.user?.name == dic["user"]["name"], "agrees with brackets");
});

// ── What only brackets can reach ─────────────────────────────────────────────

test("a computed key needs brackets", () => {
    // `d[expr]` takes any expression; `d.name` takes an identifier. This is why
    // both forms have to stay: the dot form cannot express these at all.
    let dic <string, any> = ({"name", "Sergio"});
    let k = "name";
    assert(dic[k] == "Sergio", "a key held in a variable");
    assert(dic["na" + "me"] == "Sergio", "a key built at runtime");
});

test("a key that is not a valid identifier needs brackets", () => {
    // The ordinary case is a header name. `dic.x-probe` would be a subtraction,
    // so brackets are the only way in — which the fetch tests rely on when they
    // read a response header.
    let dic <string, any> = ({"x-probe", "seen"});
    assert(dic["x-probe"] == "seen", "a hyphenated key");
    assert(dic["two words"] == null, "and one with a space is simply absent");
});

// ── DEC-M12-001: resolution is driven by the receiver, never by the name ─────
//
// On a dict, `d.k` is the key "k". The method table is not consulted for a
// property access at all, so no identifier is reserved and no key is
// unreachable. `d.k()` is the call form and still runs the method.
//
// These are the positive controls for that decision. They are written so that
// restoring "a method wins the bare name" fails every one of them.

test("DEC-M12-001: a key wins the bare name over a method of the same name", () => {
    let dic <string, any> = ({"keys", "valor"});
    assert(dic["keys"] == "valor", "the key is there");
    assert(dic.keys == "valor", "and the bare name reads it, not the method");
    assert(dic.keys == dic["keys"], "the two forms agree, collision or not");
});

test("DEC-M12-001: the call form still runs the method on that same dict", () => {
    let dic <string, any> = ({"keys", "valor"});
    let ks = dic.keys();
    assert(ks.length() == 1, "keys() returned the key list");
    assert(ks[0] == "keys", "which contains the colliding key name");
    assert(dic.keys == "valor", "and the property form still reads the value");
});

test("DEC-M12-001: every built-in name is readable as a key", () => {
    // The control the decision most needs: ten names that used to be reserved
    // by the dispatcher. If precedence is ever restored, all ten fail at once
    // rather than one obscure case failing later.
    let dic <string, any> = ({"Add", "a"}, {"Remove", "b"}, {"RemoveAll", "c"},
                             {"clear", "d"}, {"toList", "e"}, {"keys", "f"},
                             {"values", "g"}, {"toArray", "h"}, {"length", "i"},
                             {"toString", "j"});
    assert(dic.Add == "a", "Add");
    assert(dic.Remove == "b", "Remove");
    assert(dic.RemoveAll == "c", "RemoveAll");
    assert(dic.clear == "d", "clear");
    assert(dic.toList == "e", "toList");
    assert(dic.keys == "f", "keys");
    assert(dic.values == "g", "values");
    assert(dic.toArray == "h", "toArray");
    assert(dic.length == "i", "length");
    assert(dic.toString == "j", "toString");
});

test("DEC-M12-001: length is a key on a dict and a property on an array", () => {
    // `a.length` without parentheses is a documented array property and is used
    // across the corpus, so the fast path that answers it must stay — for
    // arrays. On a dict the same spelling is the key, which is why the receiver
    // and not the name decides.
    let a = [1, 2, 3];
    assert(a.length == 3, "an array answers its length as a property");
    assert(a.length() == 3, "and as a call");

    let dic <string, any> = ({"length", "I am a key"});
    assert(dic.length == "I am a key", "a dict answers the key");
    assert(dic.length() == 1, "and the call still counts the entries");

    let plain <string, any> = ({"name", "Sergio"});
    assert(plain.length == null, "with no such key there is no such value");
    assert(plain.length() == 1, "though the method still counts");
});

test("keys that do not collide behave the same way", () => {
    let dic <string, any> = ({"name", "Sergio"});
    assert(dic.name == "Sergio", "an ordinary key is read as a key");
    assert(dic.length() == 1, "and the methods still work");
});

// ── A call is still a call ───────────────────────────────────────────────────

test("an unknown method call is still an error, not a null key read", () => {
    // Dot *access* is a key; dot *call* is a call. Without the distinction, a
    // mistyped method call would silently evaluate to null.
    let dic <string, any> = ({"name", "Sergio"});
    let caught = false;
    try {
        let r = dic.notAMethod();
    } catch (e) {
        caught = true;
    }
    assert(caught, "dic.notAMethod() still reports an unknown method");
});

// ── The access forms that existed before must be unaffected ──────────────────

test("class fields and instance methods are untouched", () => {
    let p = new DotAccessProbe("Cls");
    assert(p.name == "Cls", "a class field still reads as a field");
    assert(p.greet() == "hi Cls", "an instance method still calls");
});

test("the dict's own methods are untouched", () => {
    let dic <string, any> = ({"a", 1});
    assert(dic.length() == 1, "length");
    assert(dic.keys().length() == 1, "keys");
    assert(dic.values().length() == 1, "values");
    dic.Add({"b", 2});
    assert(dic.length() == 2, "Add");
    assert(dic.b == 2, "and the added key reads back through dot");
    dic.Remove("b");
    assert(dic.length() == 1, "Remove");
    assert(dic.b == null, "the removed key is missing again");
});

summary();
