// Unit tests for type sizes.
//
// Two forms answer the same question and both work: the `sizeof(TYPE)` operator,
// which takes a type keyword (never an expression — `sizeof(5)` does not parse),
// and Memory.sizeof("type"), which takes a string and accepts "int", "decimal"
// and "bool". This file pins the table in spec/operators.md.
// (Broader Memory.sizeof coverage lives in unit_memory.)

test("Memory.sizeof int is 8", () => {
    let s = Memory.sizeof("int");
    assert(s == 8, "int should be 8 bytes");
});

test("Memory.sizeof decimal is 8", () => {
    assert(Memory.sizeof("decimal") == 8, "decimal should be 8 bytes");
});

test("Memory.sizeof bool is 1", () => {
    assert(Memory.sizeof("bool") == 1, "bool should be 1 byte");
});

test("sizeof(null) operator returns 0", () => {
    assert(sizeof(null) == 0, "null has no size");
});

test("the sizeof operator takes a type keyword", () => {
    assert(sizeof(int) == 8, "int slot is 8 bytes");
    assert(sizeof(decimal) == 8, "decimal slot is 8 bytes");
    assert(sizeof(bool) == 1, "bool slot is 1 byte");
    assert(sizeof(string) == 8, "a string slot is 8 bytes, not its contents");
});

test("both sizeof forms agree", () => {
    assert(sizeof(int) == Memory.sizeof("int"), "int");
    assert(sizeof(decimal) == Memory.sizeof("decimal"), "decimal");
    assert(sizeof(bool) == Memory.sizeof("bool"), "bool");
});

test("sizeof result is an int (participates in arithmetic)", () => {
    let s = Memory.sizeof("int");
    assert(s + 0 == 8, "sizeof result participates in arithmetic");
});

summary();
