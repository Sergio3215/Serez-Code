// std/math.sz — Extended math utilities

export fn int gcd(int a, int b) {
    if (a < 0) { a = -a; }
    if (b < 0) { b = -b; }
    while (b != 0) {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

export fn int lcm(int a, int b) {
    if (a == 0 || b == 0) { return 0; }
    return (a / gcd(a, b)) * b;
}

export fn bool isPrime(int n) {
    if (n < 2) { return false; }
    if (n == 2) { return true; }
    if (n % 2 == 0) { return false; }
    let i = 3;
    while (i * i <= n) {
        if (n % i == 0) { return false; }
        i = i + 2;
    }
    return true;
}

export fn int sign(int n) {
    if (n > 0) { return 1; }
    if (n < 0) { return -1; }
    return 0;
}

export fn int clamp(int val, int lo, int hi) {
    if (val < lo) { return lo; }
    if (val > hi) { return hi; }
    return val;
}

export fn decimal clampDecimal(decimal val, decimal lo, decimal hi) {
    if (val < lo) { return lo; }
    if (val > hi) { return hi; }
    return val;
}

export fn int factorial(int n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

export fn int combinations(int n, int k) {
    if (k < 0 || k > n) { return 0; }
    if (k == 0 || k == n) { return 1; }
    return factorial(n) / (factorial(k) * factorial(n - k));
}

export fn int permutations(int n, int k) {
    if (k < 0 || k > n) { return 0; }
    return factorial(n) / factorial(n - k);
}

export fn int fibonacci(int n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    let a = 0;
    let b = 1;
    let i = 2;
    while (i <= n) {
        let c = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

export fn [int] primes(int limit) {
    let sieve = [];
    let i = 0;
    while (i <= limit) {
        sieve.push(true);
        i = i + 1;
    }
    sieve[0] = false;
    sieve[1] = false;
    let p = 2;
    while (p * p <= limit) {
        if (sieve[p]) {
            let j = p * p;
            while (j <= limit) {
                sieve[j] = false;
                j = j + p;
            }
        }
        p = p + 1;
    }
    let result = [];
    let k = 2;
    while (k <= limit) {
        if (sieve[k]) { result.push(k); }
        k = k + 1;
    }
    return result;
}
