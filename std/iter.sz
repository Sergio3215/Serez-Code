// std/iter.sz — Iterator utilities

export fn [int] range(int start, int stop, int step) {
    if (step == 0) { throw "range() step cannot be zero"; }
    let result = [];
    let i = start;
    if (step > 0) {
        while (i < stop) { result.push(i); i = i + step; }
    } else {
        while (i > stop) { result.push(i); i = i + step; }
    }
    return result;
}

export fn [any] zip(any a, any b) {
    let result = [];
    let len = a.length();
    if (b.length() < len) { len = b.length(); }
    let i = 0;
    while (i < len) {
        result.push([a[i], b[i]]);
        i = i + 1;
    }
    return result;
}

export fn [any] enumerate(any arr) {
    let result = [];
    let i = 0;
    while (i < arr.length()) {
        result.push([i, arr[i]]);
        i = i + 1;
    }
    return result;
}

export fn [any] flatten(any arr) {
    let result = [];
    let i = 0;
    while (i < arr.length()) {
        let item = arr[i];
        if (type_of(item) == "array") {
            let j = 0;
            while (j < item.length()) {
                result.push(item[j]);
                j = j + 1;
            }
        } else {
            result.push(item);
        }
        i = i + 1;
    }
    return result;
}

export fn [any] take(any arr, int n) {
    let result = [];
    let limit = n;
    if (arr.length() < limit) { limit = arr.length(); }
    let i = 0;
    while (i < limit) { result.push(arr[i]); i = i + 1; }
    return result;
}

export fn [any] skip(any arr, int n) {
    let result = [];
    let i = n;
    while (i < arr.length()) { result.push(arr[i]); i = i + 1; }
    return result;
}

export fn [any] chunk(any arr, int size) {
    if (size <= 0) { throw "chunk() size must be positive"; }
    let result = [];
    let i = 0;
    while (i < arr.length()) {
        let piece = [];
        let j = i;
        while (j < arr.length() && j < i + size) {
            piece.push(arr[j]);
            j = j + 1;
        }
        result.push(piece);
        i = i + size;
    }
    return result;
}

export fn any first(any arr) {
    if (arr.length() == 0) { return null; }
    return arr[0];
}

export fn any last(any arr) {
    if (arr.length() == 0) { return null; }
    return arr[arr.length() - 1];
}

export fn bool all(any arr, any pred) {
    let i = 0;
    while (i < arr.length()) {
        if (!pred(arr[i])) { return false; }
        i = i + 1;
    }
    return true;
}

export fn bool any_match(any arr, any pred) {
    let i = 0;
    while (i < arr.length()) {
        if (pred(arr[i])) { return true; }
        i = i + 1;
    }
    return false;
}

export fn int count(any arr, any pred) {
    let c = 0;
    let i = 0;
    while (i < arr.length()) {
        if (pred(arr[i])) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
